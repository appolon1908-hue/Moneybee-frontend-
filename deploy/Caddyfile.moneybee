# MoneyBee edge routes.
# Import this file from the server's active Caddyfile only after all upstreams
# are healthy on the moneybee-edge Docker network.

(moneybee_hsts) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}

(moneybee_frontend_security) {
    import moneybee_hsts
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://auth.codestra.co; connect-src 'self' https://api.moneybeeloan.com https://auth.codestra.co wss://api.moneybeeloan.com; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }
}

(moneybee_api_security) {
    import moneybee_hsts
    header {
        Content-Security-Policy "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; connect-src 'self'; img-src 'none'; font-src 'none'; style-src 'none'; script-src 'none'; upgrade-insecure-requests"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }
}

moneybeeloan.com {
    encode zstd gzip
    import moneybee_frontend_security
    reverse_proxy moneybee-marketing:80
}

www.moneybeeloan.com {
    import moneybee_frontend_security
    redir https://moneybeeloan.com{uri} permanent
}

app.moneybeeloan.com {
    encode zstd gzip
    import moneybee_frontend_security
    reverse_proxy moneybee-borrower:80
}

lenders.moneybeeloan.com {
    encode zstd gzip
    import moneybee_frontend_security
    reverse_proxy moneybee-lender:80
}

# Compatibility redirect while the historical singular DNS record exists.
lender.moneybeeloan.com {
    import moneybee_frontend_security
    redir https://lenders.moneybeeloan.com{uri} permanent
}

admin.moneybeeloan.com {
    encode zstd gzip
    import moneybee_frontend_security
    reverse_proxy moneybee-admin:80
}

api.moneybeeloan.com {
    encode zstd gzip
    import moneybee_api_security
    reverse_proxy moneybee-api:8000
}
