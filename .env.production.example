VITE_API_BASE_URL=https://api.moneybeeloan.com/api/v2
VITE_BORROWER_URL=https://app.moneybeeloan.com
VITE_LENDER_URL=https://lenders.moneybeeloan.com
VITE_ADMIN_URL=https://admin.moneybeeloan.com
VITE_OIDC_AUTHORITY=https://auth.codestra.co/realms/codestra
# Set VITE_OIDC_CLIENT_ID only for an authenticated portal build:
# borrower=moneybee-borrower, lender=moneybee-lender, admin=moneybee-admin.
# The marketing application does not own an OIDC client; its Login CTA hands off
# to the borrower portal.
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=moneybee-api
