{
  "name": "moneybee-frontends",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:marketing": "pnpm --filter @moneybee/marketing dev",
    "dev:borrower": "pnpm --filter @moneybee/borrower dev",
    "dev:lender": "pnpm --filter @moneybee/lender dev",
    "dev:admin": "pnpm --filter @moneybee/admin dev",
    "build": "pnpm -r --if-present build",
    "contracts:check": "node scripts/check-api-contracts.mjs",
    "e2e:launch": "node scripts/run-launch-e2e.mjs",
    "e2e:launch:external": "playwright test -c playwright.launch.config.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
